    "onLightBlueGray": ["#2F3840", "#4A5258", "#5C6570", "#7A8490"],
    "onDarkWarm": ["#F4ECD7", "#EDE4CF", "#D4DCE3", "#B8C4CC"],
    "onDarkCool": ["#F0F2F4", "#D4DCE3", "#A8B8C4", "#8A9AA8"]
  },
  "highlights": {
    "description": "小面积高亮 · 阶段 tag · 左竖线 · strong · 禁止大面积底",
    "warm": {
      "id": "H1",
      "label": "暖琥珀",
      "base": "#B8A078",
      "deep": "#6E6248",
      "border": "#9A8868",
      "tint": "#F0E8D8",
      "onLight": "#6E6248",
      "onDark": "#E5D9BC",
      "pairsWith": ["parchment", "rose", "sage", "warmNeutral", "neutral"],
      "themes": ["warm", "warm-mixed", "neutral-warm-accent", "dark-accent"],
      "usage": "暖色主题默认高亮 · 时间轴 tag · 左 border-left · 浅底 strong"
    },
    "cool": {
      "id": "H2",
      "label": "板岩青",
      "base": "#8AADA4",
      "deep": "#4A635C",
      "border": "#6B8A82",
      "tint": "#E4EDEA",
      "onLight": "#4A635C",
      "onDark": "#A8C4BC",
      "pairsWith": ["morandiBlue", "lavender", "neutral", "charcoal"],
      "themes": ["cool-neutral", "morandi-soft"],
      "usage": "冷色主题默认高亮 · 架构 accent 线 · 代码注释色 · 替代 #64d2ff"
    }
  },
  "highlightPairing": {
    "autoByTheme": {
      "warm": "highlights.warm",
      "warm-mixed": "highlights.warm",
      "neutral-warm-accent": "highlights.warm",
      "dark-accent": "highlights.warm",
      "cool-neutral": "highlights.cool",
      "morandi-soft": "highlights.cool",
      "agent-auto": "按文章 colorTheme 自动"
    },
    "rules": [
      "全篇最多 2 种高亮（H1+H2），同屏段落只用其一",
      "高亮色仅用于 tag / 3px 以内竖线 / span级 strong，不作卡片底",
      "深底用 onDark 色阶，浅底用 deep 或 base",
      "sage.base 仍可作为色块底；高亮用于字与线，与 sage 底可共存"
    ]
  }
}
